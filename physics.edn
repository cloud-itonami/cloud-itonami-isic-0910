{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-0910"
 :cases
 [{:id :tool-crate-delivery
   :kind :transport
   :procedure "site logistics robot delivers a crate of service tools across the gravel well pad to the dispatched crew"
   :params {:mass-kg 400.0 :distance-m 250.0 :v-max-mps 2.0 :a-max-mps2 0.5 :brake-decel-mps2 1.0
            :drive-force-n 800.0 :crr 0.05 :cog-height-m 0.70 :payload-cog-height-m 1.0
            :support-half-length-m 0.60 :max-time-s 3000.0}
   :sweep {:param :payload-kg :values [50.0 100.0 200.0 300.0 400.0]}
   :quantity :cycle-time-s
   :limit {:max 200.0 :basis "estimate: a crew call-out on one pad should be served within ~3 min of dispatch"}
   :boundary {:lo 10.0 :hi 2000.0}}
  {:id :tool-crate-lift
   :kind :manipulator
   :procedure "robot arm lifts a service-tool crate from the vehicle bed onto the pad staging rack"
   :params {:l1-m 0.80 :l2-m 0.70 :m1-kg 15.0 :m2-kg 10.0
            :from [0.80 0.0] :to [0.30 1.10] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [5.0 10.0 20.0 30.0 40.0]}
   :quantity :peak-tau1-nm
   :limit {:max 400.0 :basis "estimate: continuous shoulder torque of a ~40 kg class outdoor handling arm"}
   :boundary {:lo 1.0 :hi 120.0}}]}
